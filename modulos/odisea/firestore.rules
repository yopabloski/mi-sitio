rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { match /experiences/{experienceId} { allow read: if true; allow write: if request.auth != null && request.auth.token.admin == true; match /teams/{teamId} { allow read: if request.auth != null; allow create, update: if request.auth != null && ((request.resource.data.uid == request.auth.uid && get(/databases/$(database)/documents/experiences/$(experienceId)).data.active == true) || request.auth.token.admin == true); } match /attempts/{id} { allow read: if request.auth != null; allow create: if request.auth != null && request.resource.data.teamId is string && request.resource.data.score is number && request.resource.data.validated == false && request.resource.data.route is list && request.resource.data.round == get(/databases/$(database)/documents/experiences/$(experienceId)).data.round && request.resource.data.metric == get(/databases/$(database)/documents/experiences/$(experienceId)).data.objectiveMetric && request.resource.data.route.size() == get(/databases/$(database)/documents/experiences/$(experienceId)).data.activeNodeIds.size() && request.resource.data.route.toSet().size() == request.resource.data.route.size() && request.resource.data.route[0] == 'troy' && request.resource.data.route[request.resource.data.route.size() - 1] == 'ithaca' && get(/databases/$(database)/documents/experiences/$(experienceId)).data.active == true; allow update, delete: if request.auth != null && request.auth.token.admin == true; } } } }

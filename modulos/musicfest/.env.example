# MusicFest · variables de entorno
# Copia este archivo como .env y complétalo. `.env` está en .gitignore.
#
# Importante: la configuración web de Firebase (apiKey, appId, etc.) NO es un secreto.
# Viaja siempre al navegador y queda protegida por las reglas de Firestore/Storage,
# por App Check y por la lista de dominios autorizados en Authentication.
# Estas variables sólo se usan en los scripts de Node y para generar
# modulos/musicfest/js/services/firebase-config.js en entornos distintos a producción.

# ---------- Proyecto ----------
FIREBASE_PROJECT_ID=streamlab-b9122
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=streamlab-b9122.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=789036572548
FIREBASE_APP_ID=1:789036572548:web:...

# ---------- Scripts con privilegios (Admin SDK) ----------
# Ruta a la clave de servicio (Consola > Configuración del proyecto >
# Cuentas de servicio > Generar nueva clave privada).
# NUNCA subir este archivo al repositorio: .secrets/ está en .gitignore.
#
# En realidad puedes dejarla comentada: los scripts buscan solos cualquier
# .json dentro de un .secrets/ subiendo desde el módulo.
# GOOGLE_APPLICATION_CREDENTIALS=../../.secrets/streamlab-service-account.json

# ---------- Emuladores ----------
# Para trabajar contra los emuladores basta con esto en 1; los scripts se
# encargan del resto. Con 0 (o sin la línea) escriben en PRODUCCIÓN.
USE_FIREBASE_EMULATORS=0

# No definas FIRESTORE_EMULATOR_HOST ni FIREBASE_AUTH_EMULATOR_HOST a mano:
# el Admin SDK las obedece SIEMPRE, aunque USE_FIREBASE_EMULATORS sea 0, y
# acabarías escribiendo en un emulador creyendo que hablas con producción.
# Los scripts las limpian solos por si acaso.

# ---------- Semilla de docentes ----------
# UID de Google del docente que se autoriza con `npm run admin:grant`.
MUSICFEST_ADMIN_UID=
MUSICFEST_ADMIN_EMAIL=pablogonzalez@udd.cl
